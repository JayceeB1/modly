{
  "id": "mesh-optimizer",
  "name": "Mesh Optimizer",
  "type": "process",
  "entry": "processor.py",
  "version": "1.0.0",
  "author": "Modly",
  "description": "Reduces mesh triangle count using quadric simplification (meshoptimizer).",
  "nodes": [
    {
      "id": "optimize",
      "name": "Optimize Mesh",
      "input": "mesh",
      "output": "mesh",
      "params_schema": [
        {
          "id": "target_faces",
          "label": "Detail",
          "type": "select",
          "default": 1000000,
          "tooltip": "Choose a target triangle budget. Full detail preserves the input GLB without changing it.",
          "options": [
            {
              "value": 1000000,
              "label": "Full detail (unchanged)"
            },
            {
              "value": 50000,
              "label": "Game prop (about 50,000 triangles)"
            },
            {
              "value": 10000,
              "label": "Background piece (about 10,000 triangles)"
            }
          ]
        }
      ]
    }
  ]
}
